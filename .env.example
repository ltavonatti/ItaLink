# ItaLink Italian - Environment Configuration (Optional)
# If not provided, the app runs 100% locally in offline mode,
# or users can enter custom credentials directly inside the UI.

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anonymous Public API Key
VITE_SUPABASE_ANON_KEY=

# Base Path for Vite bundling (default: ./)
BASE_PATH=./

